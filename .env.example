# ============================================================
# RallyScore — environment variables
# ============================================================
# These are required ONLY for the Vercel serverless functions
# in /api (Stripe checkout + webhook).
#
# The frontend (public/*.html) does NOT use these — it uses the
# inlined Supabase URL + publishable key, which are safe to ship.
#
# Set these in Vercel → Settings → Environment Variables.
# Do NOT commit a .env file with real values to git.
# ============================================================

# Supabase — for serverless functions only (bypasses RLS)
SUPABASE_URL=https://vasmvjhxpgfxitvadndh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_FAMILY_PRICE_ID=price_xxx_monthly_4_99
STRIPE_FAMILY_YEARLY_PRICE_ID=price_xxx_yearly_39_99

# Public — used in success/cancel redirect URLs
PUBLIC_SITE_URL=https://rallyscore.vercel.app
